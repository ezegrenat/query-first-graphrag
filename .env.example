#copiar este archivo a .env y completar con las credenciales del Neo4j propio.
#el .env no se versiona: cada quien usa el suyo.
#contenedor con OptimusKG (grafos/optimuskg/)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cambiar_esto

#contenedor con PrimeKG integrado (grafos/primekg_integrado/). La contraseña tiene que ser la
#misma que se le pasa a crear_contenedor.sh
PRIMEKG_NEO4J_URI=bolt://localhost:7688
PRIMEKG_NEO4J_USER=neo4j
PRIMEKG_NEO4J_PASSWORD=cambiar_esto
